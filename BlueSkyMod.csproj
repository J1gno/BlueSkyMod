<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standard build (Pure Ephedrine unlocks at vanilla Pseudo's required rank). -->
  <!-- ScheduleIPath and CopyToMods are configured in Directory.Build.props (override locally in Directory.Build.props.user). -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BlueSkyMod</AssemblyName>
    <IntermediateOutputPath>obj\Standard\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <RootNamespace>BlueSkyMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Main.cs" />
    <Compile Include="ItemDefinitions.cs" />
    <Compile Include="StationInjection.cs" />
    <Compile Include="VisualsAndAvatars.cs" />
    <Compile Include="UninstallWorkflow.cs" />
    <Compile Include="BlueSkySaveCleaner.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(ScheduleIPath)\MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(ScheduleIPath)\MelonLoader\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(ScheduleIPath)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(ScheduleIPath)\MelonLoader\net6\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="$(ScheduleIPath)\Mods\S1API.Il2Cpp.MelonLoader.dll" Private="false" />
    <Reference Include="$(ScheduleIPath)\MelonLoader\Il2CppAssemblies\*.dll" Private="false" />
  </ItemGroup>

  <!-- Automatically copies the built DLL into Schedule I\Mods when CopyToMods=true and the folder exists. -->
  <Target Name="CopyToMods" AfterTargets="Build" Condition="'$(CopyToMods)' == 'true' And Exists('$(ScheduleIPath)\Mods')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ScheduleIPath)\Mods" />
  </Target>
</Project>